<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp3.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <SearchBar
                Placeholder="Search Malls"
                />
            <Button
                x:Name="CounterBtn"
                Text="ANTIPOLO" 
                BackgroundColor="#EB7373"
                CornerRadius="5"
                Padding="20"
                FontSize="30"
                FontAttributes="Bold"
                HorizontalOptions="Fill" />
            <Button
            
                Text="CAINTA" 
                BackgroundColor="#EB7373"
                CornerRadius="5"
                Padding="20"
                FontSize="30"
                FontAttributes="Bold" 
            />

            <Button
                Text="METRO EAST" 
                BackgroundColor="#EB7373"
                CornerRadius="5"
                Padding="20"
                FontSize="30"
                FontAttributes="Bold"
            />

            <Button
                Text="MAGNOLIA" 
                BackgroundColor="#EB7373"
                CornerRadius="5"
                Padding="20"
                FontSize="30"
                FontAttributes="Bold"
            />
            <Button
                Text="GALLERIA" 
                BackgroundColor="#EB7373"
                CornerRadius="5"
                Padding="20"
                FontSize="30"
                FontAttributes="Bold"
            />
            <Button
                Text="OTIS" 
                 BackgroundColor="#EB7373"
                CornerRadius="5"
                Padding="20"
                FontSize="30"
                FontAttributes="Bold"
            />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
