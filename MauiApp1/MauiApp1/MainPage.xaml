<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.MainPage"
             BackgroundColor="LightPink">

    <Grid RowDefinitions="Auto, *">

        <Grid Grid.Row="0" 
              ColumnDefinitions="Auto, *" 
              Margin="10" 
              VerticalOptions="Center">

            <Label Grid.Column="0" 
                   Text="ROBINSONS" 
                   TextColor="#CC0000" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   VerticalTextAlignment="Center"
                   Margin="5,0,15,0" />

            <SearchBar Grid.Column="1" 
                       Placeholder="Search for a mall..." 
                       HeightRequest="45"
                       TextColor="Black"
                       BackgroundColor="White" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="15">

                <Button Text="ANTIPOLO                     →" 
                        HeightRequest="80"
                        FontSize="20"
                        FontAttributes="Bold"
                        BackgroundColor="RED"
                        TextColor="WHITE" 
                        BorderColor="BLACK"
                        BorderWidth="1"
                        CornerRadius="12" />

                <Button Text="CAINTA                       →" 
                        HeightRequest="80"
                        FontSize="20"
                        FontAttributes="Bold"
                        BackgroundColor="RED"
                        TextColor="WHITE" 
                        BorderColor="BLACK"
                        BorderWidth="1"
                        CornerRadius="12" />

                <Button Text="MAGNOLIA                    →" 
                        HeightRequest="80"
                        FontSize="20"
                        FontAttributes="Bold"
                        BackgroundColor="RED"
                        TextColor="WHITE" 
                        BorderColor="BLACK"
                        BorderWidth="1"
                        CornerRadius="12" />

                <Button Text="MANILA                      →" 
                        HeightRequest="80"
                        FontSize="20"
                        FontAttributes="Bold"
                        BackgroundColor="RED"
                        TextColor="WHITE" 
                        BorderColor="BLACK"
                        BorderWidth="1"
                        CornerRadius="12" />

                <Button Text="LAS PIÑAS                   →" 
                        HeightRequest="80"
                        FontSize="20"
                        FontAttributes="Bold"
                        BackgroundColor="RED"
                        TextColor="WHITE" 
                        BorderColor="BLACK"
                        BorderWidth="1"
                        CornerRadius="12" />

                <Button Text="METRO EAST                  →" 
                        HeightRequest="80"
                        FontSize="20"
                        FontAttributes="Bold"
                        BackgroundColor="RED"
                        TextColor="WHITE" 
                        BorderColor="BLACK"
                        BorderWidth="1"
                        CornerRadius="12" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>