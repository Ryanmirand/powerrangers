<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.MainPage"
             Title="ROBINSONS MALLS"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto, *">
        <SearchBar Grid.Row="0" Placeholder="Search for a mall..." Margin="10" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="15">

                <Button Text="ANTIPOLO                 →" 
                        HeightRequest="80"
                        FontSize="20"
                        FontAttributes="Bold"
                        BackgroundColor="White"
                        TextColor="#CC0000" 
                        BorderColor="#DDDDDD"
                        BorderWidth="1"
                        CornerRadius="12" />

                <Button Text="CAINTA                    →" 
                        HeightRequest="80"
                        FontSize="20"
                        FontAttributes="Bold"
                        BackgroundColor="White"
                        TextColor="#CC0000"
                        BorderColor="#DDDDDD"
                        BorderWidth="1"
                        CornerRadius="12" />

                <Button Text="MAGNOLIA               →" 
                        HeightRequest="80"
                        FontSize="20"
                        FontAttributes="Bold"
                        BackgroundColor="White"
                        TextColor="#CC0000"
                        BorderColor="#DDDDDD"
                        BorderWidth="1"
                        CornerRadius="12" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>